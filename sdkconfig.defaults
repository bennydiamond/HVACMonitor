CONFIG_AUTOSTART_ARDUINO=y
CONFIG_IDF_TARGET="esp32"
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_no_spiffs.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=n
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHMODE="qio"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ="80m"
CONFIG_COMPILER_DISABLE_GCC14_WARNINGS=y

# --- Compiler Performance & Optimization ---
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y
CONFIG_SPI_MASTER_IN_IRAM=y
CONFIG_FREERTOS_INTERRUPT_BACKTRACE=n

# --- Disable C++ Exceptions & RTTI ---
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# --- Silence Bootloader & Low-Level IDF UART Chatter ---
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL=0
CONFIG_LOG_BOOTLOADER_LEVEL_NONE=y
CONFIG_LOG_BOOTLOADER_LEVEL=0
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL=0
CONFIG_LOG_MAXIMUM_LEVEL=0
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_UART_NONE=y

# --- Bootloader App Rollback ---
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- Disable Unused IDF Components ---
CONFIG_FMB_MDNS_INTEGRATION_ENABLE=n

# --- Retain Minimal Bundle Header for Arduino v3 Compatibility ---
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=n
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_NONE=n

# --- TLS Engine (Minimal PSK / ECDHE-PSK, No RSA) ---
CONFIG_MBEDTLS_TLS_ENABLED=y
CONFIG_MBEDTLS_TLS_SERVER_AND_CLIENT=y
CONFIG_MBEDTLS_TLS_CLIENT=y
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_PSK=y
CONFIG_MBEDTLS_KEY_EXCHANGE_DHE_PSK=n
CONFIG_MBEDTLS_KEY_EXCHANGE_RSA_PSK=n
CONFIG_MBEDTLS_KEY_EXCHANGE_RSA=n
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_RSA=n
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA=n
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA=n
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDH_RSA=n

# --- Enable Minimal ECC & CMAC Required for WPA3-SAE ---
CONFIG_MBEDTLS_KEY_EXCHANGE_ELLIPTIC_CURVE=y
CONFIG_MBEDTLS_ECP_C=y
CONFIG_MBEDTLS_ECDH_C=y
CONFIG_MBEDTLS_ECDSA_C=y
CONFIG_MBEDTLS_CMAC_C=y
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=y
CONFIG_ESP_WIFI_MBEDTLS_CRYPTO=y
CONFIG_WPA_MBEDTLS_CRYPTO=y

# Keep other non-standard or bulky curves disabled:
CONFIG_MBEDTLS_ECP_DP_SECP192R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP192K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED=n

# --- Keep Heavy Asymmetric Parsers & RSA Stripped ---
CONFIG_MBEDTLS_HARDWARE_MPI=n
CONFIG_MBEDTLS_MPI_ADD_SUB_USE_HW_ACCEL=n
CONFIG_MBEDTLS_PEM_PARSE_C=n
CONFIG_MBEDTLS_PEM_WRITE_C=n
CONFIG_MBEDTLS_X509_CRL_PARSE_C=n
CONFIG_MBEDTLS_X509_CSR_PARSE_C=n
CONFIG_MBEDTLS_X509_CRT_PARSE_C=n
CONFIG_MBEDTLS_ERROR_STRINGS=n

# --- Enable WPA3-Personal (SAE) ---
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y
CONFIG_ESP_WIFI_ENABLE_SAE_H2E=y
CONFIG_ESP_WIFI_ENABLE_SAE_PK=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
CONFIG_ESP_WIFI_MBEDTLS_TLS_CLIENT=n

# --- Retain SoftAP & DHCP Server for Captive Portal ---
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_LWIP_DHCPS=y

# --- Disable Wi-Fi Protected Setup (WPS) ---
CONFIG_ESP_WIFI_ENABLE_WPS=n
CONFIG_WPA_WPS_STRICT=n
CONFIG_WPA_WPS_SOFTAP_REGISTRAR=n

# --- Disable Enterprise 802.1X & EAP Methods ---
CONFIG_ESP_WIFI_ENABLE_WPA3_ENTERPRISE=n
CONFIG_WPA_11KV_SUPPORT=n
CONFIG_WPA_11R_SUPPORT=n
CONFIG_WPA_MBO_SUPPORT=n
CONFIG_WPA_DPP_SUPPORT=n
CONFIG_WPA_SCAN_CACHE=n
CONFIG_WPA_DEBUG_PRINT=n

# --- Disable SmartConfig & Provisioning Bloat ---
CONFIG_ESP_WIFI_ENABLE_SMARTCONFIG=n
CONFIG_WIFI_PROV_AUTOSTOP_TIMEOUT=0

# --- Disable IPv6
CONFIG_LWIP_IPV6=n

# --- Completely Disable Bluetooth ---
CONFIG_BT_ENABLED=n

# --- Disable Ethernet (EMAC & SPI Ethernet Drivers) ---
CONFIG_ETH_ENABLED=n
CONFIG_ETH_USE_ESP32_EMAC=n
CONFIG_ETH_USE_SPI_ETHERNET=n

# --- Disable Point-to-Point Protocol (PPP) & Modem ---
CONFIG_LWIP_PPP_SUPPORT=n
CONFIG_ESP_MODEM_USE_PPP_MODE=n

# --- Disable LwIP unused features
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=n
CONFIG_LWIP_LOOPBACK_NETIF=n

# --- Disable RainMaker & Insights Telemetry ---
CONFIG_ESP_INSIGHTS_ENABLED=n
CONFIG_ESP_RMAKER_CONSOLE_ENABLED=n

# --- Disable Legacy Peripheral Drivers Replaced by New Drivers ---
CONFIG_TWAI_ERRATA_FIX_BUS_OFF_REC=n
CONFIG_ADC_DISABLE_DAC=y

# --- Disable Esp32-idf 
#CONFIG_ESP_ERR_LOG_LEVEL_SILENT=y
#CONFIG_ESP_LOG_TOOL_PREFIX=n


# --- Strip Unused SHA-512 Software Implementation ---
CONFIG_MBEDTLS_SHA512_C=n